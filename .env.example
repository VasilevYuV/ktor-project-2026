# Copy this file to .env and fill in the required secrets. Never commit .env.
# When reusing an existing PostgreSQL volume, keep its original database password.
DATABASE_PASSWORD=
# Generate a random value (at least 32 UTF-8 bytes); keep it across restarts.
JWT_SECRET=

# Optional administrator bootstrap: set BOTH fields or leave BOTH empty.
# Login: 3-32 Latin letters/digits/underscores. Password: 12+ characters, at most 72 UTF-8 bytes.
# An existing USER is never promoted; an existing ADMIN password is never overwritten.
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Published ports bind only to 127.0.0.1. Change them if another project uses these ports.
APP_PORT=8080
POSTGRES_PORT=55432

DATABASE_POOL_SIZE=5
JWT_ISSUER=kotlin-task-api
JWT_AUDIENCE=kotlin-task-client
JWT_EXPIRES_IN_SECONDS=3600
